@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap');

:root {
  --neutral-primary-soft: #0d0e18;
  --neutral-primary: #0d0e18;
  --neutral-primary-medium: #13131e;
  --neutral-primary-strong: #1a1a28;
  --neutral-secondary-medium: #13131e;
  --neutral-tertiary: #1a1a28;
  --neutral-tertiary-medium: #222233;

  --brand: #818cf8;
  --brand-softer: rgba(99, 102, 241, 0.08);
  --brand-soft: rgba(99, 102, 241, 0.15);
  --brand-medium: rgba(99, 102, 241, 0.15);
  --brand-strong: #a5b4fc;

  --cyan: #22d3ee;
  --cyan-soft: rgba(34, 211, 238, 0.1);

  --success: #34d399;
  --danger: #f87171;
  --warning: #fbbf24;

  --heading: #f0f0f5;
  --body: #a0a3b5;
  --body-subtle: #6b6e80;
  --fg-brand: #818cf8;
  --fg-brand-strong: #a5b4fc;
  --fg-cyan: #22d3ee;
  --fg-disabled: #4a4d5e;
  --fg-danger: #f87171;

  --border-default-subtle: #1a1a28;
  --border-default: #222233;
  --border-default-medium: #2a2b3a;
  --border-default-strong: #3a3b4a;
  --border-brand: #818cf8;
  --border-brand-subtle: rgba(99, 102, 241, 0.2);
  --border-cyan: #22d3ee;
  --border-buffer: #0a0a12;

  --gradient-1: linear-gradient(135deg, #818cf8, #6366f1, #a78bfa);
  --gradient-2: linear-gradient(135deg, #22d3ee, #6366f1, #a78bfa);
  --gradient-3: linear-gradient(135deg, #818cf8, #22d3ee);

  --font-mono: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
  --font-code: 'JetBrains Mono', monospace;

  --radius-base: 12px;
  --radius-sm: 8px;
  --radius-lg: 20px;
  --radius-full: 9999px;

  --shadow-xs: 0 1px 2px rgba(0, 0, 0, 0.4);
  --shadow-sm: 0 2px 6px rgba(0, 0, 0, 0.4);
  --shadow-md: 0 4px 16px rgba(0, 0, 0, 0.5);
  --shadow-lg: 0 8px 32px rgba(0, 0, 0, 0.6);
  --shadow-xl: 0 16px 48px rgba(0, 0, 0, 0.7);

  --glow-brand: 0 0 40px rgba(99, 102, 241, 0.15);
  --glow-cyan: 0 0 40px rgba(34, 211, 238, 0.1);
  --glow-strong: 0 0 60px rgba(99, 102, 241, 0.2);
}

*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  height: 100%;
}

body {
  min-height: 100%;
  background: var(--neutral-primary-soft);
  color: var(--body);
  font-family: var(--font-mono);
  font-size: 15px;
  line-height: 1.7;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  overflow-x: hidden;
  transition: background 0.3s;
}

a { color: inherit; text-decoration: none; }
img { max-width: 100%; height: auto; display: block; }
button { font-family: inherit; cursor: pointer; }
input, textarea { font-family: inherit; }

h1, h2, h3, h4, h5, h6 { color: var(--heading); font-weight: 700; }
h1 { font-size: 32px; line-height: 1.05; letter-spacing: -0.03em; margin-bottom: 24px; }
h2 { font-size: 26px; line-height: 1.1; letter-spacing: -0.02em; margin-bottom: 32px; }
h3 { font-size: 22px; line-height: 1.15; letter-spacing: -0.02em; }

@media (min-width: 768px) {
  h1 { font-size: 40px; }
  h2 { font-size: 32px; }
  h3 { font-size: 26px; }
}
@media (min-width: 1024px) {
  h1 { font-size: 56px; }
  h2 { font-size: 40px; }
  h3 { font-size: 32px; }
}

p { font-size: 15px; line-height: 1.7; color: var(--body); max-width: 65ch; }

::selection { background: var(--brand); color: var(--neutral-primary-soft); }
:focus-visible { outline: 2px solid var(--brand); outline-offset: 2px; }

::-webkit-scrollbar { width: 8px; }
::-webkit-scrollbar-track { background: var(--neutral-primary-soft); border-left: 1px solid var(--border-default); }
::-webkit-scrollbar-thumb { background: linear-gradient(180deg, var(--brand), var(--cyan)); border-radius: 4px; border: 2px solid var(--neutral-primary-soft); }
::-webkit-scrollbar-thumb:hover { background: linear-gradient(180deg, var(--brand-strong), var(--cyan)); }
* { scrollbar-width: thin; scrollbar-color: var(--brand) var(--neutral-primary-soft); }

/* ── Animated Gradient Background Orbs ── */
.mesh-bg {
  position: fixed;
  inset: 0;
  z-index: -1;
  overflow: hidden;
  pointer-events: none;
}

.mesh-bg .blob {
  position: absolute;
  border-radius: 50%;
  filter: blur(100px);
  opacity: 0;
  will-change: transform;
  animation: orbPulse 4s ease-in-out infinite;
}

.mesh-bg .blob:nth-child(1) {
  width: 700px;
  height: 700px;
  background: radial-gradient(circle, rgba(99, 102, 241, 0.35), transparent 70%);
  top: -15%;
  left: -10%;
  animation: orbFloat1 22s ease-in-out infinite, orbPulse 6s ease-in-out infinite 0s;
  opacity: 0.35;
}

.mesh-bg .blob:nth-child(2) {
  width: 600px;
  height: 600px;
  background: radial-gradient(circle, rgba(34, 211, 238, 0.3), transparent 70%);
  top: 30%;
  right: -12%;
  animation: orbFloat2 28s ease-in-out infinite, orbPulse 5s ease-in-out infinite 1s;
  opacity: 0.3;
}

.mesh-bg .blob:nth-child(3) {
  width: 550px;
  height: 550px;
  background: radial-gradient(circle, rgba(167, 139, 250, 0.3), transparent 70%);
  bottom: -10%;
  left: 25%;
  animation: orbFloat3 25s ease-in-out infinite, orbPulse 7s ease-in-out infinite 2s;
  opacity: 0.3;
}

.mesh-bg .blob:nth-child(4) {
  width: 450px;
  height: 450px;
  background: radial-gradient(circle, rgba(99, 102, 241, 0.25), transparent 70%);
  top: 55%;
  left: -8%;
  animation: orbFloat4 20s ease-in-out infinite, orbPulse 5.5s ease-in-out infinite 0.5s;
  opacity: 0.25;
}

.mesh-bg .blob:nth-child(5) {
  width: 400px;
  height: 400px;
  background: radial-gradient(circle, rgba(34, 211, 238, 0.22), transparent 70%);
  top: 10%;
  right: 20%;
  animation: orbFloat5 30s ease-in-out infinite, orbPulse 6.5s ease-in-out infinite 1.5s;
  opacity: 0.2;
}

@keyframes orbFloat1 {
  0%, 100% { transform: translate(0, 0) scale(1); }
  25% { transform: translate(100px, 80px) scale(1.1); }
  50% { transform: translate(40px, 140px) scale(0.95); }
  75% { transform: translate(-60px, 60px) scale(1.05); }
}

@keyframes orbFloat2 {
  0%, 100% { transform: translate(0, 0) scale(1); }
  25% { transform: translate(-80px, -100px) scale(1.1); }
  50% { transform: translate(-120px, -40px) scale(0.9); }
  75% { transform: translate(-30px, -80px) scale(1.05); }
}

@keyframes orbFloat3 {
  0%, 100% { transform: translate(0, 0) scale(1); }
  25% { transform: translate(-60px, -80px) scale(0.9); }
  50% { transform: translate(80px, -40px) scale(1.1); }
  75% { transform: translate(40px, -60px) scale(0.95); }
}

@keyframes orbFloat4 {
  0%, 100% { transform: translate(0, 0) scale(1); }
  25% { transform: translate(60px, 50px) scale(1.1); }
  50% { transform: translate(100px, -30px) scale(0.9); }
  75% { transform: translate(30px, 60px) scale(1.05); }
}

@keyframes orbFloat5 {
  0%, 100% { transform: translate(0, 0) scale(1); }
  25% { transform: translate(-40px, 60px) scale(1.05); }
  50% { transform: translate(60px, 100px) scale(0.95); }
  75% { transform: translate(-30px, 40px) scale(1.1); }
}

@keyframes orbPulse {
  0%, 100% { opacity: var(--orb-opacity, 0.2); }
  50% { opacity: calc(var(--orb-opacity, 0.2) + 0.08); }
}

/* ── Subtle Vignette Overlay ── */
.vignette-overlay {
  pointer-events: none;
  position: fixed;
  inset: 0;
  z-index: 9999;
  background: radial-gradient(
    ellipse at center,
    transparent 50%,
    rgba(13, 14, 24, 0.22) 100%
  );
}

/* ── Section Divider ── */
.section-divider {
  height: 1px;
  background: linear-gradient(90deg, transparent, var(--border-default), transparent);
  max-width: 1280px;
  margin: 0 auto;
  position: relative;
}

.section-divider::after {
  content: '';
  position: absolute;
  top: -1px;
  left: 50%;
  transform: translateX(-50%);
  width: 80px;
  height: 3px;
  background: var(--gradient-1);
  border-radius: 2px;
  opacity: 0.5;
}

/* ── Scroll Reveal ── */
.reveal {
  opacity: 0;
  transform: translateY(60px) scale(0.97);
  transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1),
              transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  will-change: transform, opacity;
}

.reveal.visible {
  opacity: 1;
  transform: translateY(0) scale(1);
}

.reveal-delay-1 { transition-delay: 0.06s; }
.reveal-delay-2 { transition-delay: 0.12s; }
.reveal-delay-3 { transition-delay: 0.18s; }
.reveal-delay-4 { transition-delay: 0.24s; }
.reveal-delay-5 { transition-delay: 0.3s; }
.reveal-delay-6 { transition-delay: 0.36s; }

/* ── Floating Stars / Space Background ── */
.particles {
  position: fixed;
  inset: 0;
  z-index: -1;
  pointer-events: none;
  overflow: hidden;
}

/* =========================================================
   RANDOM BACKGROUND STARS
   Không dùng repeating gradient để tránh pattern hình chữ nhật
   ========================================================= */
.particles::before {
  content: '';
  position: absolute;

  width: 2px;
  height: 2px;

  top: 0;
  left: 0;

  border-radius: 50%;
  background: rgba(255, 255, 255, 0.9);

  box-shadow:
    4vw 7vh 0 rgba(255,255,255,0.55),
    11vw 18vh 0 rgba(165,180,252,0.45),
    17vw 5vh 0 rgba(255,255,255,0.40),
    23vw 31vh 0 rgba(34,211,238,0.38),
    29vw 12vh 0 rgba(255,255,255,0.62),
    34vw 44vh 0 rgba(129,140,248,0.42),
    39vw 8vh 0 rgba(255,255,255,0.48),
    45vw 24vh 0 rgba(34,211,238,0.30),
    51vw 15vh 0 rgba(255,255,255,0.58),
    57vw 37vh 0 rgba(165,180,252,0.48),
    62vw 6vh 0 rgba(255,255,255,0.38),
    68vw 21vh 0 rgba(34,211,238,0.38),
    74vw 11vh 0 rgba(255,255,255,0.57),
    81vw 33vh 0 rgba(129,140,248,0.40),
    87vw 8vh 0 rgba(255,255,255,0.48),
    94vw 19vh 0 rgba(34,211,238,0.32),

    7vw 49vh 0 rgba(165,180,252,0.36),
    14vw 64vh 0 rgba(255,255,255,0.52),
    20vw 78vh 0 rgba(34,211,238,0.30),
    27vw 55vh 0 rgba(255,255,255,0.42),
    33vw 88vh 0 rgba(129,140,248,0.46),
    41vw 69vh 0 rgba(255,255,255,0.58),
    48vw 52vh 0 rgba(34,211,238,0.32),
    54vw 83vh 0 rgba(255,255,255,0.40),
    61vw 61vh 0 rgba(165,180,252,0.43),
    67vw 91vh 0 rgba(255,255,255,0.52),
    73vw 73vh 0 rgba(34,211,238,0.30),
    79vw 57vh 0 rgba(255,255,255,0.47),
    85vw 86vh 0 rgba(129,140,248,0.40),
    92vw 68vh 0 rgba(255,255,255,0.55),
    97vw 94vh 0 rgba(34,211,238,0.28),

    3vw 91vh 0 rgba(255,255,255,0.42),
    9vw 35vh 0 rgba(34,211,238,0.25),
    19vw 42vh 0 rgba(255,255,255,0.35),
    31vw 72vh 0 rgba(165,180,252,0.35),
    37vw 27vh 0 rgba(255,255,255,0.38),
    44vw 95vh 0 rgba(34,211,238,0.28),
    58vw 47vh 0 rgba(255,255,255,0.40),
    64vw 79vh 0 rgba(165,180,252,0.34),
    71vw 43vh 0 rgba(255,255,255,0.42),
    76vw 96vh 0 rgba(34,211,238,0.28),
    89vw 47vh 0 rgba(255,255,255,0.40),
    96vw 52vh 0 rgba(165,180,252,0.32);

  opacity: 0.65;

  animation: backgroundStarTwinkle 5s ease-in-out infinite;
}

/* =========================================================
   SHOOTING STAR
   Bay từ trái trên -> phải dưới
   ========================================================= */
.particles::after {
  content: '';
  position: absolute;

  top: 10%;
  left: -220px;

  width: 180px;
  height: 2px;

  border-radius: 999px;

  /*
    Bên phải là đầu sao sáng.
    Bên trái là đuôi mờ.
  */
  background: linear-gradient(
    90deg,
    transparent 0%,
    rgba(34, 211, 238, 0.08) 30%,
    rgba(129, 140, 248, 0.35) 65%,
    rgba(255, 255, 255, 1) 100%
  );

  box-shadow:
    15px 0 7px rgba(255,255,255,0.40),
    35px 0 12px rgba(129,140,248,0.30),
    70px 0 20px rgba(34,211,238,0.12);

  opacity: 0;

  transform-origin: right center;

  animation: shootingStar 15s ease-out infinite;
}

/* =========================================================
   12 NGÔI SAO BAY LÊN
   ========================================================= */
.particle {
  position: absolute;

  width: 8px;
  height: 8px;

  opacity: 0;

  animation: particleFloat linear infinite;
}

/* Ngôi sao bốn cánh */
.particle::before {
  content: '';

  position: absolute;
  inset: 0;

  background: linear-gradient(
    135deg,
    #ffffff 0%,
    #e0e7ff 28%,
    #a5b4fc 58%,
    #22d3ee 100%
  );

  clip-path: polygon(
    50% 0%,
    60% 40%,
    100% 50%,
    60% 60%,
    50% 100%,
    40% 60%,
    0% 50%,
    40% 40%
  );

  filter:
    drop-shadow(0 0 2px rgba(255,255,255,0.9))
    drop-shadow(0 0 5px rgba(129,140,248,0.7))
    drop-shadow(0 0 9px rgba(34,211,238,0.3));

  animation: starTwinkle 2.8s ease-in-out infinite;
}

/* =========================================================
   VỊ TRÍ + KÍCH THƯỚC + TỐC ĐỘ
   ========================================================= */

.particle:nth-child(1) {
  left: 7%;
  width: 5px;
  height: 5px;
  animation-duration: 25s;
  animation-delay: -3s;
}

.particle:nth-child(2) {
  left: 16%;
  width: 9px;
  height: 9px;
  animation-duration: 29s;
  animation-delay: -14s;
}

.particle:nth-child(3) {
  left: 27%;
  width: 4px;
  height: 4px;
  animation-duration: 23s;
  animation-delay: -9s;
}

.particle:nth-child(4) {
  left: 38%;
  width: 7px;
  height: 7px;
  animation-duration: 31s;
  animation-delay: -18s;
}

.particle:nth-child(5) {
  left: 49%;
  width: 11px;
  height: 11px;
  animation-duration: 28s;
  animation-delay: -6s;
}

.particle:nth-child(6) {
  left: 59%;
  width: 5px;
  height: 5px;
  animation-duration: 33s;
  animation-delay: -22s;
}

.particle:nth-child(7) {
  left: 68%;
  width: 8px;
  height: 8px;
  animation-duration: 27s;
  animation-delay: -11s;
}

.particle:nth-child(8) {
  left: 78%;
  width: 4px;
  height: 4px;
  animation-duration: 24s;
  animation-delay: -19s;
}

.particle:nth-child(9) {
  left: 89%;
  width: 10px;
  height: 10px;
  animation-duration: 30s;
  animation-delay: -4s;
}

.particle:nth-child(10) {
  left: 33%;
  width: 5px;
  height: 5px;
  animation-duration: 26s;
  animation-delay: -16s;
}

.particle:nth-child(11) {
  left: 56%;
  width: 6px;
  height: 6px;
  animation-duration: 34s;
  animation-delay: -25s;
}

.particle:nth-child(12) {
  left: 83%;
  width: 9px;
  height: 9px;
  animation-duration: 29s;
  animation-delay: -13s;
}

/* =========================================================
   SAO BAY LÊN
   ========================================================= */
@keyframes particleFloat {
  0% {
    transform:
      translate3d(0, 110vh, 0)
      scale(0.5)
      rotate(0deg);

    opacity: 0;
  }

  10% {
    opacity: 0.55;
  }

  30% {
    transform:
      translate3d(12px, 70vh, 0)
      scale(0.75)
      rotate(20deg);

    opacity: 0.8;
  }

  55% {
    transform:
      translate3d(-8px, 40vh, 0)
      scale(1)
      rotate(45deg);

    opacity: 0.9;
  }

  80% {
    transform:
      translate3d(10px, 10vh, 0)
      scale(0.9)
      rotate(70deg);

    opacity: 0.55;
  }

  100% {
    transform:
      translate3d(-5px, -15vh, 0)
      scale(0.7)
      rotate(90deg);

    opacity: 0;
  }
}

/* =========================================================
   SAO LỚN LẤP LÁNH
   ========================================================= */
@keyframes starTwinkle {
  0%,
  100% {
    opacity: 0.30;
    transform: scale(0.70) rotate(0deg);
  }

  40% {
    opacity: 0.60;
    transform: scale(0.90) rotate(12deg);
  }

  52% {
    opacity: 1;
    transform: scale(1.35) rotate(25deg);
  }

  70% {
    opacity: 0.55;
    transform: scale(0.85) rotate(38deg);
  }
}

/* =========================================================
   SAO NHỎ PHÍA SAU NHẤP NHÁY
   ========================================================= */
@keyframes backgroundStarTwinkle {
  0%,
  100% {
    opacity: 0.42;
  }

  25% {
    opacity: 0.62;
  }

  50% {
    opacity: 0.48;
  }

  75% {
    opacity: 0.70;
  }
}

/* =========================================================
   SAO BĂNG: TRÁI TRÊN -> PHẢI DƯỚI
   ========================================================= */
@keyframes shootingStar {
  0%,
  68% {
    opacity: 0;

    transform:
      translate3d(0, 0, 0)
      rotate(32deg);
  }

  70% {
    opacity: 0;
  }

  72% {
    opacity: 1;
  }

  78% {
    opacity: 0.95;
  }

  88% {
    opacity: 0;

    transform:
      translate3d(125vw, 70vh, 0)
      rotate(32deg);
  }

  100% {
    opacity: 0;

    transform:
      translate3d(125vw, 70vh, 0)
      rotate(32deg);
  }
}

/* Accessibility */
@media (prefers-reduced-motion: reduce) {
  .particles::after,
  .particle,
  .particle::before {
    animation: none !important;
  }

  .particle {
    display: none;
  }

  .particles::before {
    animation: none;
    opacity: 0.45;
  }
}

/* ── Scroll To Top ── */
.scrollToTop {
  position: fixed;
  bottom: 32px;
  right: 32px;
  z-index: 90;
  width: 52px;
  height: 52px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--brand), #6366f1);
  border: none;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  opacity: 0;
  visibility: hidden;
  transform: translateY(20px);
  transition: opacity 0.35s, visibility 0.35s, transform 0.35s, box-shadow 0.3s, filter 0.3s;
  box-shadow: 0 4px 24px rgba(99, 102, 241, 0.4);
}

.scrollToTop.visible {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
}

.scrollToTop:hover {
  box-shadow: 0 8px 40px rgba(99, 102, 241, 0.55);
  filter: brightness(1.15);
  transform: translateY(-4px) scale(1.05);
}

.scrollToTop:active {
  transform: translateY(0) scale(0.95);
}

.scrollToTop::after {
  content: '';
  position: absolute;
  inset: -4px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--brand), transparent, var(--cyan));
  opacity: 0;
  transition: opacity 0.3s;
  z-index: -1;
}

.scrollToTop:hover::after {
  opacity: 0.5;
}

.scrollToTop svg {
  width: 24px;
  height: 24px;
  transition: transform 0.25s;
  filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.3));
}

.scrollToTop:hover svg {
  transform: translateY(-3px);
}

@media (max-width: 767px) {
  .scrollToTop {
    bottom: 20px;
    right: 20px;
    width: 48px;
    height: 48px;
  }

  .scrollToTop svg {
    width: 22px;
    height: 22px;
  }
}

/* ── Section Scroll Margin ── */
section[id] {
  scroll-margin-top: 80px;
}

/* ── Keyframes ── */
@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(24px); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes glowPulse {
  0%, 100% { box-shadow: 0 0 8px rgba(99, 102, 241, 0.2); }
  50% { box-shadow: 0 0 24px rgba(99, 102, 241, 0.45); }
}

@keyframes shimmer {
  0% { background-position: -200% center; }
  100% { background-position: 200% center; }
}

@keyframes borderGlow {
  0%, 100% { border-color: var(--border-default); }
  50% { border-color: var(--border-brand); }
}

@keyframes gradientShift {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10px); }
}

@keyframes rotateGradient {
  to { transform: rotate(360deg); }
}

@keyframes scaleIn {
  from { opacity: 0; transform: scale(0.9); }
  to { opacity: 1; transform: scale(1); }
}

@keyframes slideInLeft {
  from { opacity: 0; transform: translateX(-30px); }
  to { opacity: 1; transform: translateX(0); }
}

@keyframes textGradient {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

/* ===== PORTFOLIO HOVER SAFETY ===== */
@media (hover: none), (pointer: coarse) {
  * {
    -webkit-tap-highlight-color: transparent;
  }
}
