/* ==========================================================
   THEME TOGGLE BUTTON
   ========================================================== */

.themeToggle {
  position: fixed;

  top: 88px;
  right: 32px;

  z-index: 95;

  width: 52px;
  height: 52px;

  display: flex;

  align-items: center;
  justify-content: center;

  overflow: visible;

  border-radius: 50%;

  border:
    1px solid
    rgba(129,140,248,0.26);

  outline: none;

  color:
    #c8c9ff;

  background:
    linear-gradient(
      145deg,
      rgba(21,20,38,0.94),
      rgba(11,13,26,0.96)
    );

  box-shadow:
    0 7px 25px
    rgba(0,0,0,0.25),
    inset 0 0 18px
    rgba(99,102,241,0.05);

  cursor: pointer;

  opacity: 0;

  transform:
    translateY(-8px)
    scale(0.9);

  transition:
    opacity 0.35s,
    transform 0.32s
      cubic-bezier(.16,.84,.28,1),
    border-color 0.3s,
    background 0.4s,
    color 0.3s,
    box-shadow 0.3s;
}


.themeToggleMounted {
  opacity: 1;

  transform:
    translateY(0)
    scale(1);
}


.themeToggle:hover {
  transform:
    translateY(-3px)
    scale(1.10);

  color:
    #fff7ba;

  border-color:
    rgba(163,145,255,0.75);

  box-shadow:
    0 12px 35px
    rgba(0,0,0,0.30),

    0 0 18px
    rgba(129,140,248,0.38),

    0 0 42px
    rgba(99,102,241,0.22);
}


.themeToggle:active {
  transform:
    translateY(0)
    scale(0.94);
}


.themeToggleAura {
  position: absolute;

  inset: -10px;

  z-index: -1;

  border-radius: 50%;

  opacity: 0;

  pointer-events: none;

  background:
    radial-gradient(
      circle,
      rgba(255,220,91,0.23),
      rgba(129,140,248,0.16) 38%,
      transparent 68%
    );

  filter:
    blur(2px);

  transform:
    scale(0.65);

  transition:
    opacity 0.3s,
    transform 0.35s;
}


.themeToggle:hover
.themeToggleAura {
  opacity: 1;

  transform:
    scale(1.45);

  animation:
    lampAura
    1.7s
    ease-in-out
    infinite;
}


.themeIcon {
  position: relative;

  z-index: 3;

  width: 23px;
  height: 23px;

  transition:
    transform 0.45s
      cubic-bezier(.16,.84,.28,1),
    filter 0.3s,
    color 0.3s;
}


.themeSun {
  filter:
    drop-shadow(
      0 0 4px
      rgba(255,223,111,0.40)
    );
}


.themeToggle:hover
.themeSun {
  transform:
    rotate(35deg)
    scale(1.12);

  filter:
    drop-shadow(
      0 0 7px
      rgba(255,225,112,0.95)
    )

    drop-shadow(
      0 0 14px
      rgba(255,195,72,0.45)
    );
}


.themeToggle:hover
.themeMoon {
  transform:
    rotate(-15deg)
    scale(1.10);
}


/* ==========================================================
   SMALL STARS ON BUTTON
   ========================================================== */

.themeToggleStars {
  position: absolute;

  inset: -9px;

  pointer-events: none;

  opacity: 0;

  transition:
    opacity 0.3s;
}


.themeToggle:hover
.themeToggleStars {
  opacity: 1;
}


.themeToggleStars i {
  position: absolute;

  width: 3px;
  height: 3px;

  border-radius: 50%;

  background:
    #ffffff;

  box-shadow:
    0 0 7px
    rgba(255,255,255,0.9);

  animation:
    themeStar
    1.4s
    ease-in-out
    infinite;
}


.themeToggleStars i:nth-child(1) {
  top: 5px;
  right: 5px;
}


.themeToggleStars i:nth-child(2) {
  bottom: 4px;
  left: 8px;

  animation-delay:
    -0.5s;
}


.themeToggleStars i:nth-child(3) {
  top: 11px;
  left: 1px;

  animation-delay:
    -0.9s;
}


/* ==========================================================
   LABEL
   ========================================================== */

.themeToggleLabel {
  position: absolute;

  right: 61px;

  top: 50%;

  transform:
    translate(
      8px,
      -50%
    );

  padding:
    5px 8px;

  border:
    1px solid
    rgba(124,110,219,0.16);

  border-radius: 5px;

  background:
    rgba(10,11,22,0.88);

  color:
    rgba(213,210,236,0.77);

  font-family:
    ui-monospace,
    SFMono-Regular,
    Menlo,
    Monaco,
    Consolas,
    monospace;

  font-size: 6px;

  letter-spacing:
    0.12em;

  pointer-events: none;

  white-space: nowrap;

  opacity: 0;

  visibility: hidden;

  transition:
    opacity 0.25s,
    transform 0.25s,
    visibility 0.25s;
}


.themeToggle:hover
.themeToggleLabel {
  opacity: 1;

  visibility: visible;

  transform:
    translate(
      0,
      -50%
    );
}


/* ==========================================================
   LIGHT VERSION OF BUTTON
   ========================================================== */

.themeToggleLight {
  color:
    #5a49d4;

  border-color:
    rgba(104,87,229,0.23);

  background:
    linear-gradient(
      145deg,
      rgba(255,255,255,0.97),
      rgba(237,241,250,0.96)
    );

  box-shadow:
    0 8px 27px
    rgba(35,44,71,0.13),
    inset 0 1px 0
    rgba(255,255,255,0.9);
}


.themeToggleLight:hover {
  color:
    #4234b7;

  border-color:
    rgba(104,87,229,0.55);

  box-shadow:
    0 12px 34px
    rgba(35,44,71,0.17),

    0 0 32px
    rgba(104,87,229,0.18);
}


.themeToggleLight
.themeToggleAura {
  background:
    radial-gradient(
      circle,
      rgba(104,87,229,0.18),
      rgba(8,145,178,0.08) 40%,
      transparent 68%
    );
}


.themeToggleLight
.themeToggleLabel {
  color:
    #525b70;

  border-color:
    rgba(91,82,170,0.14);

  background:
    rgba(255,255,255,0.94);

  box-shadow:
    0 6px 18px
    rgba(31,40,70,0.08);
}


/* ==========================================================
   ANIMATIONS
   ========================================================== */

@keyframes lampAura {
  0%,
  100% {
    opacity: 0.55;

    transform:
      scale(1.15);
  }

  50% {
    opacity: 1;

    transform:
      scale(1.50);
  }
}


@keyframes themeStar {
  0%,
  100% {
    opacity: 0.25;

    transform:
      scale(0.5);
  }

  50% {
    opacity: 1;

    transform:
      scale(1.3);
  }
}


/* ==========================================================
   MOBILE
   ========================================================== */

@media (max-width: 767px) {
  .themeToggle {
    top: 78px;
    right: 20px;

    width: 48px;
    height: 48px;
  }


  .themeIcon {
    width: 21px;
    height: 21px;
  }


  .themeToggleLabel {
    display: none;
  }
}


/* ==========================================================
   REDUCED MOTION
   ========================================================== */

@media (prefers-reduced-motion: reduce) {
  .themeToggle,
  .themeToggleAura,
  .themeIcon,
  .themeToggleStars i {
    animation: none !important;

    transition-duration:
      0.01ms !important;
  }
}


/* ===== PORTFOLIO LIGHT THEME END ===== */
