   ========================================================== */

html,
body {
  transition:
    background-color 0.45s ease,
    color 0.45s ease;
}


body {
  transition:
    background 0.45s ease,
    color 0.45s ease;
}


html[data-theme='light'] body {
  background:
    radial-gradient(
      circle at 12% 20%,
      rgba(104,87,229,0.045),
      transparent 30%
    ),
    radial-gradient(
      circle at 84% 45%,
      rgba(8,145,178,0.035),
      transparent 32%
    ),
    #f4f7fb;

  color:
    var(--body);
}


/* ==========================================================
   LIGHT NAVBAR
