/* =========================================================
   SAO BAY LÊN
   ========================================================= */
@keyframes particleFloat {
  0% {
    transform:
      translate3d(0, 110vh, 0)
      scale(0.5)
      rotate(0deg);

    opacity: 0;
  }

  10% {
    opacity: 0.55;
  }

  30% {
    transform:
      translate3d(12px, 70vh, 0)
      scale(0.75)
      rotate(20deg);

    opacity: 0.8;
  }

  55% {
    transform:
      translate3d(-8px, 40vh, 0)
      scale(1)
      rotate(45deg);

    opacity: 0.9;
  }

  80% {
    transform:
      translate3d(10px, 10vh, 0)
      scale(0.9)
      rotate(70deg);

    opacity: 0.55;
  }

  100% {
    transform:
      translate3d(-5px, -15vh, 0)
      scale(0.7)
      rotate(90deg);

    opacity: 0;
  }
}

/* =========================================================
   SAO LỚN LẤP LÁNH
   ========================================================= */
@keyframes starTwinkle {
  0%,
  100% {
    opacity: 0.30;
    transform: scale(0.70) rotate(0deg);
  }

  40% {
    opacity: 0.60;
    transform: scale(0.90) rotate(12deg);
  }

  52% {
    opacity: 1;
    transform: scale(1.35) rotate(25deg);
  }

  70% {
    opacity: 0.55;
    transform: scale(0.85) rotate(38deg);
  }
}

/* =========================================================
   SAO NHỎ PHÍA SAU NHẤP NHÁY
   ========================================================= */
@keyframes backgroundStarTwinkle {
  0%,
  100% {
    opacity: 0.42;
  }

  25% {
    opacity: 0.62;
  }

  50% {
    opacity: 0.48;
  }

  75% {
    opacity: 0.70;
  }
}

/* =========================================================
   SAO BĂNG: TRÁI TRÊN -> PHẢI DƯỚI
   ========================================================= */
@keyframes shootingStar {
  0%,
  68% {
    opacity: 0;

    transform:
      translate3d(0, 0, 0)
      rotate(32deg);
  }

  70% {
    opacity: 0;
  }

  72% {
    opacity: 1;
  }

  78% {
    opacity: 0.95;
  }

  88% {
    opacity: 0;

    transform:
      translate3d(125vw, 70vh, 0)
      rotate(32deg);
  }

  100% {
    opacity: 0;

    transform:
      translate3d(125vw, 70vh, 0)
      rotate(32deg);
  }
}

/* Accessibility */
@media (prefers-reduced-motion: reduce) {
  .particles::after,
  .particle,
  .particle::before {
    animation: none !important;
  }

  .particle {
    display: none;
  }

  .particles::before {
    animation: none;
    opacity: 0.45;
  }
}

/* ── Scroll To Top ── */
.scrollToTop {
  position: fixed;
  bottom: 32px;
  right: 32px;
  z-index: 90;
  width: 52px;
  height: 52px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--brand), #6366f1);
  border: none;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  opacity: 0;
  visibility: hidden;
  transform: translateY(20px);
  transition: opacity 0.35s, visibility 0.35s, transform 0.35s, box-shadow 0.3s, filter 0.3s;
  box-shadow: 0 4px 24px rgba(99, 102, 241, 0.4);
}

.scrollToTop.visible {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
}

.scrollToTop:hover {
  box-shadow: 0 8px 40px rgba(99, 102, 241, 0.55);
  filter: brightness(1.15);
  transform: translateY(-4px) scale(1.05);
}

.scrollToTop:active {
  transform: translateY(0) scale(0.95);
}

.scrollToTop::after {
  content: '';
  position: absolute;
  inset: -4px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--brand), transparent, var(--cyan));
  opacity: 0;
  transition: opacity 0.3s;
  z-index: -1;
}

.scrollToTop:hover::after {
  opacity: 0.5;
}

.scrollToTop svg {
  width: 24px;
  height: 24px;
  transition: transform 0.25s;
  filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.3));
}

.scrollToTop:hover svg {
  transform: translateY(-3px);
}

@media (max-width: 767px) {
  .scrollToTop {
    bottom: 20px;
    right: 20px;
    width: 48px;
    height: 48px;
  }

  .scrollToTop svg {
    width: 22px;
    height: 22px;
  }
}

/* ── Section Scroll Margin ── */
section[id] {
  scroll-margin-top: 80px;
}

/* ── Keyframes ── */
@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(24px); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes glowPulse {
  0%, 100% { box-shadow: 0 0 8px rgba(99, 102, 241, 0.2); }
  50% { box-shadow: 0 0 24px rgba(99, 102, 241, 0.45); }
}

@keyframes shimmer {
  0% { background-position: -200% center; }
  100% { background-position: 200% center; }
}

@keyframes borderGlow {
  0%, 100% { border-color: var(--border-default); }
  50% { border-color: var(--border-brand); }
}

@keyframes gradientShift {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10px); }
}

@keyframes rotateGradient {
  to { transform: rotate(360deg); }
}

@keyframes scaleIn {
  from { opacity: 0; transform: scale(0.9); }
  to { opacity: 1; transform: scale(1); }
}

@keyframes slideInLeft {
  from { opacity: 0; transform: translateX(-30px); }
  to { opacity: 1; transform: translateX(0); }
}

@keyframes textGradient {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

/* ===== PORTFOLIO HOVER SAFETY ===== */
@media (hover: none), (pointer: coarse) {
  * {
    -webkit-tap-highlight-color: transparent;
  }
}

