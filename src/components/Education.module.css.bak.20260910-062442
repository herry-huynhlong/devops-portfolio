.educationStage {
  position: relative;
  isolation: isolate;
}


/* ==========================================================
   BACKGROUND TECH GRID
   ========================================================== */

.backgroundGrid {
  position: absolute;
  inset: -55px -25px;

  z-index: 0;

  pointer-events: none;

  opacity: 0.16;

  background-image:
    linear-gradient(
      rgba(115, 105, 190, 0.08) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(115, 105, 190, 0.08) 1px,
      transparent 1px
    );

  background-size: 42px 42px;

  mask-image:
    radial-gradient(
      ellipse at center,
      black 0%,
      rgba(0, 0, 0, 0.65) 55%,
      transparent 85%
    );

  -webkit-mask-image:
    radial-gradient(
      ellipse at center,
      black 0%,
      rgba(0, 0, 0, 0.65) 55%,
      transparent 85%
    );
}


/* ==========================================================
   NETWORK TOPOLOGY DECORATION
   ========================================================== */

.topology {
  position: absolute;

  inset: -45px 0;

  z-index: 0;

  pointer-events: none;

  overflow: hidden;

  opacity: 0.38;
}


.topology span {
  position: absolute;

  width: 5px;
  height: 5px;

  border-radius: 50%;

  background: rgba(129, 113, 255, 0.8);

  box-shadow:
    0 0 5px rgba(129, 113, 255, 0.8),
    0 0 13px rgba(129, 113, 255, 0.35);

  animation:
    topologyPulse 3s ease-in-out infinite;
}


.node1 {
  top: 11%;
  left: 18%;
}


.node2 {
  top: 24%;
  right: 23%;

  animation-delay: -0.8s !important;
}


.node3 {
  bottom: 14%;
  left: 35%;

  animation-delay: -1.6s !important;
}


.node4 {
  bottom: 27%;
  right: 8%;

  animation-delay: -2.1s !important;
}


.topology i {
  position: absolute;

  height: 1px;

  transform-origin: left center;

  background:
    linear-gradient(
      90deg,
      transparent,
      rgba(108, 97, 224, 0.18),
      transparent
    );
}


.link1 {
  width: 30%;
  left: 18%;
  top: 12%;

  transform: rotate(11deg);
}


.link2 {
  width: 28%;
  left: 36%;
  bottom: 16%;

  transform: rotate(-18deg);
}


.link3 {
  width: 22%;
  right: 5%;
  top: 28%;

  transform: rotate(72deg);
}


/* ==========================================================
   GRID
   ========================================================== */

.grid {
  position: relative;

  z-index: 2;

  display: grid;

  grid-template-columns: 1fr;

  gap: 22px;
}


/* ==========================================================
   CARD
   ========================================================== */

.card {
  --card-delay: 0ms;

  position: relative;

  overflow: hidden;

  border:
    1px solid rgba(115, 101, 219, 0.24);

  border-radius:
    var(--radius-lg);

  background:
    linear-gradient(
      135deg,
      rgba(17, 17, 34, 0.94),
      rgba(12, 15, 29, 0.91)
    );

  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.015),
    0 18px 60px rgba(0, 0, 0, 0.08);

  opacity: 0;

  transform:
    translateY(24px)
    scale(0.99);

  transition:
    border-color 0.35s,
    box-shadow 0.35s,
    transform 0.35s;

  animation-delay:
    var(--card-delay);
}


.stageVisible .card {
  animation:
    cardBoot 0.75s cubic-bezier(.22,.8,.35,1)
    forwards;

  animation-delay:
    var(--card-delay);
}


.card::before {
  content: '';

  position: absolute;

  top: 0;
  left: 0;

  width: 3px;
  height: 100%;

  background:
    linear-gradient(
      180deg,
      #8b72ff,
      #54c8ff,
      transparent
    );

  opacity: 0.78;
}


.card::after {
  content: '';

  position: absolute;

  width: 430px;
  height: 430px;

  right: -210px;
  top: -250px;

  border-radius: 50%;

  background:
    radial-gradient(
      circle,
      rgba(101, 82, 221, 0.12),
      rgba(57, 151, 224, 0.04) 35%,
      transparent 70%
    );

  pointer-events: none;
}


.card:hover {
  transform:
    translateY(-3px);

  border-color:
    rgba(133, 115, 255, 0.55);

  box-shadow:
    0 16px 55px rgba(0, 0, 0, 0.18),
    0 0 35px rgba(93, 75, 220, 0.08),
    inset 0 0 35px rgba(91, 75, 202, 0.025);
}


.cardFeatured {
  background:
    radial-gradient(
      circle at 82% 42%,
      rgba(80, 103, 210, 0.055),
      transparent 35%
    ),
    linear-gradient(
      135deg,
      rgba(19, 17, 37, 0.96),
      rgba(11, 15, 28, 0.92)
    );
}


/* ==========================================================
   CORNER HUD
   ========================================================== */

.cornerTL,
.cornerBR {
  position: absolute;

  width: 17px;
  height: 17px;

  opacity: 0.42;

  pointer-events: none;
}


.cornerTL {
  top: 8px;
  left: 11px;

  border-top:
    1px solid rgba(129, 113, 255, 0.75);

  border-left:
    1px solid rgba(129, 113, 255, 0.75);
}


.cornerBR {
  right: 9px;
  bottom: 9px;

  border-right:
    1px solid rgba(88, 193, 235, 0.6);

  border-bottom:
    1px solid rgba(88, 193, 235, 0.6);
}


/* ==========================================================
   SCAN
   ========================================================== */

.scanBeam {
  position: absolute;

  top: -8%;
  left: 0;

  z-index: 5;

  width: 100%;
  height: 1px;

  pointer-events: none;

  opacity: 0;

  background:
    linear-gradient(
      90deg,
      transparent 4%,
      rgba(119, 101, 255, 0.55),
      rgba(73, 200, 239, 0.42),
      transparent 96%
    );

  box-shadow:
    0 0 10px rgba(105, 91, 242, 0.28);
}


.card:hover .scanBeam {
  animation:
    scanCard 2.6s linear infinite;
}


/* ==========================================================
   CARD HEADER
   ========================================================== */

.cardHeader {
  position: relative;

  z-index: 3;

  height: 42px;

  display: flex;

  align-items: center;

  justify-content: space-between;

  padding:
    0 27px;

  border-bottom:
    1px solid rgba(111, 101, 183, 0.11);

  background:
    rgba(6, 8, 17, 0.18);

  font-family:
    ui-monospace,
    SFMono-Regular,
    Menlo,
    Monaco,
    Consolas,
    monospace;

  font-size: 8px;

  letter-spacing: 0.12em;
}


.nodeIdentity {
  display: flex;

  align-items: center;

  gap: 7px;

  color:
    rgba(161, 155, 200, 0.67);
}


.nodeDot {
  width: 5px;
  height: 5px;

  border-radius: 50%;

  background:
    rgba(111, 204, 255, 0.83);

  box-shadow:
    0 0 9px rgba(83, 196, 255, 0.6);

  animation:
    topologyPulse 2s ease-in-out infinite;
}


.runtime {
  display: flex;

  align-items: center;

  gap: 6px;

  color:
    rgba(158, 155, 191, 0.7);
}


.runtimeDot {
  width: 5px;
  height: 5px;

  border-radius: 50%;

  background:
    rgba(152, 147, 184, 0.6);
}


.runtimeComplete {
  color:
    rgba(98, 220, 170, 0.78);
}


.runtimeComplete .runtimeDot {
  background:
    rgba(82, 233, 166, 0.95);

  box-shadow:
    0 0 8px rgba(82, 233, 166, 0.55);

  animation:
    statusPulse 1.8s ease-in-out infinite;
}


/* ==========================================================
   MAIN LAYOUT
   ========================================================== */

.cardLayout {
  position: relative;

  z-index: 2;

  display: grid;

  grid-template-columns:
    minmax(0, 1fr) 250px;

  min-height: 245px;
}


.primary {
  position: relative;

  padding: 26px 30px 25px;

  min-width: 0;
}


.cardWithImage .primary {
  display: grid;

  grid-template-columns: 110px 1fr;

  column-gap: 24px;
}


.headingBlock {
  min-width: 0;
}


.commandLabel {
  display: block;

  margin-bottom: 5px;

  font-family:
    ui-monospace,
    SFMono-Regular,
    Menlo,
    Monaco,
    Consolas,
    monospace;

  font-size: 8px;

  letter-spacing: 0.14em;

  text-transform: uppercase;

  color:
    rgba(115, 181, 239, 0.57);
}


.title {
  margin: 0;

  font-size: 20px;

  font-weight: 720;

  line-height: 1.25;

  color:
    var(--heading);
}


.degree {
  margin-top: 5px;

  font-size: 14px;

  color:
    var(--fg-brand);

  line-height: 1.5;
}


.meta {
  display: flex;

  flex-wrap: wrap;

  align-items: center;

  gap: 7px;

  margin-top: 6px;

  font-size: 11px;

  color:
    var(--body-subtle);
}


.metaSeparator {
  color:
    rgba(121, 105, 221, 0.55);
}


/* ==========================================================
   IMAGE
   ========================================================== */

.imageWrap {
  width: 110px;
  height: 110px;

  grid-row: span 2;

  overflow: hidden;

  border-radius:
    var(--radius-base);

  border:
    1px solid rgba(123, 109, 217, 0.23);

  background:
    var(--neutral-primary-soft);
}


.imageWrap img {
  width: 100%;
  height: 100%;

  object-fit: cover;
}


/* ==========================================================
   MODULES
   ========================================================== */

.modules {
  margin-top: 22px;

  padding-top: 15px;

  border-top:
    1px solid rgba(118, 109, 181, 0.10);
}


.cardWithImage .modules {
  grid-column: 1 / -1;
}


.modulesHeader {
  display: flex;

  justify-content:
    space-between;

  margin-bottom: 10px;

  font-family:
    ui-monospace,
    SFMono-Regular,
    Menlo,
    Monaco,
    Consolas,
    monospace;

  font-size: 7px;

  letter-spacing: 0.11em;

  color:
    rgba(145, 142, 175, 0.52);
}


.details {
  list-style: none;

  display: flex;

  flex-direction: column;

  gap: 7px;

  margin: 0;

  padding: 0;
}


.details li {
  --detail-delay: 0ms;

  position: relative;

  display: grid;

  grid-template-columns:
    14px minmax(0, 1fr) 16px;

  align-items: start;

  gap: 3px;

  font-size: 12px;

  line-height: 1.55;

  color:
    var(--body);

  opacity: 0;

  transform:
    translateX(-7px);
}


.stageVisible .details li {
  animation:
    moduleLoad 0.45s ease forwards;

  animation-delay:
    var(--detail-delay);
}


.detailPrompt {
  color:
    var(--brand);

  font-family:
    ui-monospace,
    monospace;

  font-weight: 700;
}


.detailCheck {
  color:
    rgba(84, 216, 166, 0.60);

  font-family:
    ui-monospace,
    monospace;

  font-size: 10px;
}


/* ==========================================================
   ACHIEVEMENT
   ========================================================== */

.achievement {
  display: flex;

  align-items: center;

  gap: 10px;

  margin-top: 17px;

  font-size: 9px;
}


.achievement span {
  padding:
    3px 7px;

  border:
    1px solid rgba(50, 200, 226, 0.18);

  border-radius: 4px;

  font-family:
    ui-monospace,
    monospace;

  letter-spacing: 0.08em;

  color:
    rgba(93, 204, 229, 0.67);
}


.achievement strong {
  color:
    rgba(198, 204, 219, 0.75);

  font-size: 10px;

  font-weight: 500;
}


/* ==========================================================
   STATUS PANEL
   ========================================================== */

.statusPanel {
  position: relative;

  display: flex;

  flex-direction: column;

  justify-content: center;

  padding: 22px 25px;

  border-left:
    1px solid rgba(110, 101, 180, 0.12);

  background:
    linear-gradient(
      180deg,
      rgba(17, 20, 36, 0.32),
      rgba(8, 11, 21, 0.15)
    );
}


.statusPanelHeader {
  position: absolute;

  top: 15px;
  left: 20px;

  font-family:
    ui-monospace,
    monospace;

  font-size: 7px;

  letter-spacing: 0.13em;

  color:
    rgba(151, 146, 184, 0.48);
}


/* ==========================================================
   PROGRESS RING
   ========================================================== */

.progressVisual {
  display: flex;

  justify-content: center;

  margin:
    12px 0 18px;
}


.progressRing {
  position: relative;

  width: 88px;
  height: 88px;

  display: grid;

  place-items: center;

  border-radius: 50%;

  background:
    conic-gradient(
      rgba(117, 98, 241, 0.12) 0deg,
      rgba(117, 98, 241, 0.12) 360deg
    );
}


.stageVisible .progressRing {
  animation:
    ringGlow 1.2s ease 0.65s both;
}


.progressRing::before {
  content: '';

  position: absolute;

  inset: 0;

  border-radius: 50%;

  background:
    conic-gradient(
      from -90deg,
      #7565f6 0deg,
      #5da2f1 215deg,
      #50d5d2 359deg,
      transparent 360deg
    );

  mask:
    radial-gradient(
      farthest-side,
      transparent calc(100% - 4px),
      #000 calc(100% - 3px)
    );

  -webkit-mask:
    radial-gradient(
      farthest-side,
      transparent calc(100% - 4px),
      #000 calc(100% - 3px)
    );

  transform:
    rotate(-120deg);

  opacity: 0;
}


.stageVisible .progressRing::before {
  animation:
    ringBoot 1.2s cubic-bezier(.22,.75,.25,1)
    0.55s forwards;
}


.progressRingInner {
  width: 67px;
  height: 67px;

  display: flex;

  align-items: baseline;

  justify-content: center;

  border-radius: 50%;

  background:
    radial-gradient(
      circle,
      rgba(92, 78, 197, 0.07),
      rgba(9, 12, 24, 0.65)
    );

  border:
    1px solid rgba(116, 104, 206, 0.10);
}


.progressRingInner strong {
  align-self: center;

  font-family:
    ui-monospace,
    monospace;

  font-size: 20px;

  font-weight: 600;

  color:
    rgba(213, 215, 238, 0.88);
}


.progressRingInner span {
  margin-left: 2px;

  align-self: center;

  font-family:
    ui-monospace,
    monospace;

  font-size: 8px;

  color:
    rgba(105, 204, 218, 0.66);
}


/* ==========================================================
   TIMELINE
   ========================================================== */

.timeline {
  margin-bottom: 17px;
}


.timelineYears {
  display: flex;

  justify-content:
    space-between;

  margin-bottom: 7px;

  font-family:
    ui-monospace,
    monospace;

  font-size: 8px;

  color:
    rgba(159, 157, 190, 0.62);
}


.timelineTrack {
  position: relative;

  height: 3px;

  border-radius: 5px;

  background:
    rgba(111, 105, 161, 0.13);
}


.timelineFill {
  position: absolute;

  inset: 0;

  transform:
    scaleX(0);

  transform-origin:
    left center;

  border-radius: inherit;

  background:
    linear-gradient(
      90deg,
      #765ffc,
      #5a9cf0,
      #52d3cf
    );

  box-shadow:
    0 0 8px rgba(91, 123, 234, 0.23);
}


.stageVisible .timelineFill {
  animation:
    timelineComplete 1.35s cubic-bezier(.2,.75,.25,1)
    0.7s forwards;
}


.timelineStart,
.timelineEnd {
  position: absolute;

  top: 50%;

  width: 7px;
  height: 7px;

  border-radius: 50%;

  transform:
    translateY(-50%);

  background:
    #8171ef;

  border:
    2px solid #131426;
}


.timelineStart {
  left: -2px;
}


.timelineEnd {
  right: -2px;

  opacity: 0;
}


.stageVisible .timelineEnd {
  animation:
    endpointOnline 0.3s ease 1.95s forwards;
}


/* ==========================================================
   PIPELINE INFO
   ========================================================== */

.pipelineInfo {
  display: flex;

  flex-direction: column;

  gap: 5px;

  margin-top: 1px;

  padding:
    9px 0;

  border-top:
    1px solid rgba(111, 103, 177, 0.09);

  border-bottom:
    1px solid rgba(111, 103, 177, 0.09);
}


.pipelineInfo div {
  display: flex;

  justify-content:
    space-between;

  font-family:
    ui-monospace,
    monospace;

  font-size: 7px;
}


.pipelineInfo span {
  color:
    rgba(145, 144, 169, 0.50);
}


.pipelineInfo strong {
  color:
    rgba(91, 218, 167, 0.65);

  font-weight: 500;
}


/* ==========================================================
   STATUS BADGE
   ========================================================== */

.status {
  align-self: center;

  display: inline-flex;

  align-items: center;

  gap: 7px;

  margin-top: 13px;

  padding:
    5px 12px;

  border:
    1px solid rgba(130, 115, 226, 0.23);

  border-radius:
    var(--radius-full);

  background:
    rgba(105, 87, 220, 0.065);

  font-family:
    ui-monospace,
    monospace;

  font-size: 8px;

  font-weight: 600;

  letter-spacing: 0.09em;

  text-transform: uppercase;

  color:
    rgba(176, 163, 246, 0.78);

  opacity: 0;
}


.stageVisible .status {
  animation:
    statusOnline 0.45s ease 2s forwards;
}


.status i {
  width: 5px;
  height: 5px;

  border-radius: 50%;

  background:
    rgba(129, 113, 236, 0.8);
}


.statusCompleted {
  border-color:
    rgba(80, 211, 163, 0.18);

  background:
    rgba(62, 190, 145, 0.055);

  color:
    rgba(102, 224, 175, 0.72);
}


.statusCompleted i {
  background:
    rgba(75, 232, 166, 0.92);

  box-shadow:
    0 0 7px rgba(75, 232, 166, 0.5);

  animation:
    statusPulse 1.7s ease-in-out infinite;
}


/* ==========================================================
   FOOTER
   ========================================================== */

.cardFooter {
  position: relative;

  z-index: 3;

  min-height: 34px;

  display: flex;

  align-items: center;

  gap: 13px;

  padding:
    0 27px;

  border-top:
    1px solid rgba(111, 103, 177, 0.10);

  font-family:
    ui-monospace,
    monospace;

  font-size: 7px;

  letter-spacing: 0.08em;

  color:
    rgba(141, 140, 166, 0.43);
}


.cardFooter strong {
  margin-left: auto;

  color:
    rgba(85, 212, 166, 0.58);

  font-weight: 500;
}


.footerDots {
  display: flex;

  gap: 3px;
}


.footerDots i {
  width: 3px;
  height: 3px;

  border-radius: 50%;

  background:
    rgba(112, 99, 219, 0.48);

  animation:
    footerSignal 1.4s ease-in-out infinite;
}


.footerDots i:nth-child(2) {
  animation-delay: -0.45s;
}


.footerDots i:nth-child(3) {
  animation-delay: -0.9s;
}


/* ==========================================================
   ANIMATION
   ========================================================== */

@keyframes cardBoot {
  from {
    opacity: 0;
    transform:
      translateY(24px)
      scale(0.99);
  }

  to {
    opacity: 1;
    transform:
      translateY(0)
      scale(1);
  }
}


@keyframes moduleLoad {
  from {
    opacity: 0;
    transform:
      translateX(-7px);
  }

  to {
    opacity: 1;
    transform:
      translateX(0);
  }
}


@keyframes timelineComplete {
  from {
    transform:
      scaleX(0);
  }

  to {
    transform:
      scaleX(1);
  }
}


@keyframes endpointOnline {
  from {
    opacity: 0;
    transform:
      translateY(-50%)
      scale(0.3);
  }

  to {
    opacity: 1;
    transform:
      translateY(-50%)
      scale(1);
  }
}


@keyframes statusOnline {
  from {
    opacity: 0;
    transform:
      translateY(5px);
  }

  to {
    opacity: 1;
    transform:
      translateY(0);
  }
}


@keyframes ringBoot {
  from {
    opacity: 0;
    transform:
      rotate(-180deg);
  }

  to {
    opacity: 0.84;
    transform:
      rotate(0);
  }
}


@keyframes ringGlow {
  0% {
    filter:
      drop-shadow(
        0 0 0 rgba(86, 102, 235, 0)
      );
  }

  70% {
    filter:
      drop-shadow(
        0 0 9px rgba(86, 102, 235, 0.19)
      );
  }

  100% {
    filter:
      drop-shadow(
        0 0 4px rgba(86, 102, 235, 0.10)
      );
  }
}


@keyframes scanCard {
  0% {
    top: 2%;
    opacity: 0;
  }

  10% {
    opacity: 0.7;
  }

  90% {
    opacity: 0.35;
  }

  100% {
    top: 98%;
    opacity: 0;
  }
}


@keyframes topologyPulse {
  0%,
  100% {
    opacity: 0.25;
    transform: scale(0.75);
  }

  50% {
    opacity: 1;
    transform: scale(1.15);
  }
}


@keyframes statusPulse {
  0%,
  100% {
    opacity: 0.42;
  }

  50% {
    opacity: 1;
  }
}


@keyframes footerSignal {
  0%,
  100% {
    opacity: 0.25;
  }

  50% {
    opacity: 0.85;
  }
}


/* ==========================================================
   MOBILE
   ========================================================== */

@media (max-width: 767px) {
  .cardLayout {
    grid-template-columns: 1fr;
  }

  .primary {
    padding:
      22px 20px;
  }

  .cardWithImage .primary {
    grid-template-columns:
      80px 1fr;

    gap: 17px;
  }

  .imageWrap {
    width: 80px;
    height: 80px;
  }

  .title {
    font-size: 17px;
  }

  .statusPanel {
    border-left: 0;

    border-top:
      1px solid rgba(110, 101, 180, 0.12);

    padding:
      28px 22px 20px;
  }

  .statusPanelHeader {
    top: 12px;
  }

  .progressVisual {
    margin-top: 8px;
  }

  .cardHeader {
    padding:
      0 18px;
  }

  .cardFooter {
    padding:
      0 18px;
  }

  .backgroundGrid {
    inset:
      -25px -10px;
  }
}


/* ==========================================================
   REDUCED MOTION
   ========================================================== */

@media (prefers-reduced-motion: reduce) {
  .card,
  .details li,
  .status,
  .timelineFill,
  .timelineEnd,
  .progressRing,
  .progressRing::before,
  .topology span,
  .runtimeDot,
  .footerDots i,
  .scanBeam {
    animation: none !important;
  }

  .card,
  .details li,
  .status,
  .timelineEnd {
    opacity: 1;
    transform: none;
  }

  .timelineFill {
    transform: scaleX(1);
  }

  .progressRing::before {
    opacity: 0.8;
    transform: rotate(0);
  }
}

/* ===== GLOBAL HOVER DEPTH START ===== */

.card {
  transform-origin: center center;
}

.card:hover {
  z-index: 20;

  transform:
    translateY(-7px)
    scale(1.025);

  border-color:
    rgba(139, 119, 255, 0.65);

  box-shadow:
    0 24px 55px
      rgba(0,0,0,0.26),
    0 0 38px
      rgba(101,82,228,0.15),
    inset 0 0 35px
      rgba(91,75,202,0.035);
}

/* ===== GLOBAL HOVER DEPTH END ===== */
