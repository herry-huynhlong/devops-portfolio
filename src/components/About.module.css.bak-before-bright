.aboutStage {
  position: relative;
  isolation: isolate;
}


/* =========================================================
   FOREGROUND - GIỮ NGUYÊN ABOUT CŨ
   ========================================================= */

.grid {
  position: relative;
  z-index: 3;

  display: grid;
  grid-template-columns: 1fr 280px;
  gap: 48px;
  align-items: center;
}

.text {
  position: relative;
  z-index: 3;
}

.text p {
  font-size: 15px;
  line-height: 1.7;
  margin-bottom: 16px;
  color: var(--body);
}

.text p:last-child {
  margin-bottom: 0;
}


.imageWrap {
  position: relative;
  z-index: 4;
}

.imageGlow {
  position: absolute;
  inset: -12px;

  background:
    radial-gradient(
      ellipse at center,
      rgba(99, 102, 241, 0.1),
      transparent 70%
    );

  border-radius: var(--radius-lg);

  opacity: 0;

  transition: opacity 0.4s;

  pointer-events: none;
}

.imageWrap:hover .imageGlow {
  opacity: 1;
}


.imagePlaceholder {
  width: 280px;
  height: 320px;

  background:
    var(--neutral-primary-medium);

  border:
    1px solid var(--border-default);

  border-radius:
    var(--radius-lg);

  display: flex;

  flex-direction: column;

  align-items: center;
  justify-content: center;

  gap: 12px;

  color:
    var(--body-subtle);

  font-size: 11px;

  text-transform: uppercase;

  letter-spacing: 0.06em;

  position: relative;

  overflow: hidden;

  transition:
    border-color 0.3s,
    box-shadow 0.3s;
}

.imagePlaceholder:hover {
  border-color:
    var(--border-brand);

  box-shadow:
    var(--glow-brand);
}

.imagePlaceholder svg {
  width: 48px;
  height: 48px;

  color:
    var(--border-default-strong);
}

.imagePlaceholder img {
  width: 100%;
  height: 100%;

  object-fit: cover;

  border-radius:
    var(--radius-lg);
}

.imagePlaceholder::after {
  content: '';

  position: absolute;

  top: -50%;
  left: -50%;

  width: 200%;
  height: 200%;

  background:
    conic-gradient(
      from 0deg,
      transparent,
      rgba(99, 102, 241, 0.04),
      transparent 60%
    );

  animation:
    rotateGradient 10s linear infinite;

  pointer-events: none;
}


.socialOverlay {
  display: flex;

  gap: 16px;

  margin-top: 20px;

  justify-content: center;
}

.socialOverlay a {
  color:
    var(--body-subtle);

  transition:
    color 0.2s,
    transform 0.2s;
}

.socialOverlay a:hover {
  color:
    var(--brand);

  transform:
    translateY(-3px);
}


/* =========================================================
   LINUX BACKGROUND
   Chỉ là visual layer.
   Không tác động layout/click.
   ========================================================= */

.linuxBackdrop {
  position: absolute;

  z-index: 0;

  /*
   * Chỉ phủ phần bên trái / giữa.
   * Không đè mạnh lên ảnh.
   */
  top: -78px;
  left: -38px;
  right: 245px;
  bottom: -95px;

  overflow: hidden;

  pointer-events: none;

  opacity: 0.46;

  mask-image:
    linear-gradient(
      90deg,
      rgba(0, 0, 0, 1) 0%,
      rgba(0, 0, 0, 0.92) 70%,
      transparent 100%
    );

  -webkit-mask-image:
    linear-gradient(
      90deg,
      rgba(0, 0, 0, 1) 0%,
      rgba(0, 0, 0, 0.92) 70%,
      transparent 100%
    );
}


/* =========================================================
   MAIN TERMINAL
   ========================================================= */

.terminalWindow {
  position: absolute;

  width: min(620px, 78%);

  height: 270px;

  left: 8px;
  top: 48px;

  overflow: hidden;

  border-radius: 10px;

  border:
    1px solid rgba(128, 112, 255, 0.13);

  background:
    linear-gradient(
      145deg,
      rgba(12, 13, 26, 0.21),
      rgba(8, 12, 22, 0.09)
    );

  box-shadow:
    0 0 40px rgba(93, 79, 220, 0.035),
    inset 0 0 30px rgba(80, 64, 170, 0.02);

  transform:
    rotate(-1.1deg);

  filter:
    blur(0.08px);

  opacity: 0.38;

  animation:
    terminalFloat 9s ease-in-out infinite;
}


.terminalHeader {
  height: 30px;

  display: flex;

  align-items: center;

  padding:
    0 10px;

  gap: 10px;

  border-bottom:
    1px solid rgba(130, 120, 220, 0.10);

  background:
    rgba(12, 12, 24, 0.26);

  font-family:
    ui-monospace,
    SFMono-Regular,
    Menlo,
    Monaco,
    Consolas,
    monospace;

  font-size: 9px;

  color:
    rgba(203, 200, 238, 0.52);
}


.windowControls {
  display: flex;

  gap: 4px;
}


.windowControls span {
  display: block;

  width: 6px;
  height: 6px;

  border-radius: 50%;

  background:
    rgba(139, 125, 255, 0.37);
}


.windowControls span:nth-child(2) {
  opacity: 0.67;
}


.windowControls span:nth-child(3) {
  opacity: 0.4;
}


.terminalTitle {
  flex: 1;

  text-align: center;

  letter-spacing: 0.04em;
}


.terminalStatus {
  font-size: 8px;

  letter-spacing: 0.12em;

  color:
    rgba(82, 207, 255, 0.48);
}


.terminalBody {
  padding: 14px 16px;

  font-family:
    ui-monospace,
    SFMono-Regular,
    Menlo,
    Monaco,
    Consolas,
    'Liberation Mono',
    monospace;

  font-size: 10px;

  line-height: 1.65;

  color:
    rgba(205, 204, 230, 0.49);
}


.terminalSession {
  animation:
    terminalRefresh 3.4s ease-in-out both;
}


.commandLine {
  display: flex;

  align-items: center;

  white-space: nowrap;

  min-height: 17px;
}


.promptUser {
  color:
    rgba(100, 218, 181, 0.66);
}


.promptColon {
  color:
    rgba(190, 185, 220, 0.48);
}


.promptPath {
  color:
    rgba(112, 159, 255, 0.67);
}


.promptDollar {
  margin-right: 7px;

  color:
    rgba(190, 185, 220, 0.46);
}


.command {
  overflow: hidden;

  color:
    rgba(176, 157, 255, 0.69);

  text-shadow:
    0 0 8px
    rgba(118, 97, 255, 0.14);
}


.commandOutput {
  margin:
    5px 0 8px 0;

  padding-left: 9px;

  border-left:
    1px solid rgba(116, 105, 206, 0.12);

  color:
    rgba(181, 183, 205, 0.42);
}


.cursor {
  color:
    rgba(111, 218, 255, 0.73);

  animation:
    cursorBlink 1s steps(1) infinite;
}


.scanLine {
  position: absolute;

  left: 0;
  right: 0;

  height: 1px;

  top: 0;

  opacity: 0;

  background:
    linear-gradient(
      90deg,
      transparent,
      rgba(124, 107, 255, 0.5),
      rgba(73, 204, 255, 0.35),
      transparent
    );

  box-shadow:
    0 0 9px rgba(101, 88, 255, 0.25);

  animation:
    terminalScan 7s linear infinite;
}


/* =========================================================
   SYSTEM MONITOR
   ========================================================= */

.systemMonitor {
  position: absolute;

  top: 192px;
  right: 21px;

  width: 205px;

  min-height: 158px;

  padding: 12px;

  border:
    1px solid rgba(101, 181, 255, 0.105);

  border-radius: 8px;

  background:
    rgba(9, 13, 25, 0.16);

  font-family:
    ui-monospace,
    SFMono-Regular,
    Menlo,
    Monaco,
    Consolas,
    monospace;

  opacity: 0.27;

  transform:
    rotate(1.2deg);

  animation:
    monitorFloat 11s ease-in-out infinite;
}


.monitorHeader {
  display: flex;

  justify-content:
    space-between;

  align-items: center;

  font-size: 8px;

  letter-spacing: 0.09em;

  color:
    rgba(172, 167, 220, 0.5);
}


.liveStatus {
  display: flex;

  gap: 4px;

  align-items: center;

  color:
    rgba(97, 225, 170, 0.59);
}


.liveStatus i {
  display: block;

  width: 4px;
  height: 4px;

  border-radius: 50%;

  background:
    rgba(82, 235, 167, 0.85);

  box-shadow:
    0 0 7px
    rgba(82, 235, 167, 0.65);

  animation:
    statusPulse 1.6s ease-in-out infinite;
}


.hostname {
  margin:
    11px 0 12px;

  font-size: 9px;

  color:
    rgba(116, 193, 255, 0.5);
}


.metric {
  margin-bottom: 9px;
}


.metricInfo {
  display: flex;

  justify-content:
    space-between;

  margin-bottom: 4px;

  font-size: 7px;

  color:
    rgba(175, 178, 207, 0.47);
}


.metricBar {
  position: relative;

  height: 2px;

  overflow: hidden;

  border-radius: 2px;

  background:
    rgba(125, 120, 170, 0.11);
}


.metricBar span {
  position: absolute;

  top: 0;
  left: 0;
  bottom: 0;

  border-radius: inherit;

  background:
    linear-gradient(
      90deg,
      rgba(106, 97, 244, 0.55),
      rgba(68, 197, 240, 0.5)
    );

  transform-origin: left;

  animation:
    metricActivity 4s ease-in-out infinite alternate;
}


.cpuBar {
  width: 34%;
}


.ramBar {
  width: 47%;

  animation-delay:
    -1.1s !important;
}


.netBar {
  width: 61%;

  animation-delay:
    -2s !important;
}


.monitorFooter {
  display: flex;

  justify-content:
    space-between;

  margin-top: 12px;

  padding-top: 8px;

  border-top:
    1px solid rgba(117, 112, 190, 0.09);

  font-size: 6px;

  letter-spacing: 0.05em;

  color:
    rgba(135, 207, 201, 0.42);
}


/* =========================================================
   JOURNAL LOG PANEL
   ========================================================= */

.logWindow {
  position: absolute;

  left: 55px;
  bottom: 7px;

  width: min(540px, 68%);

  height: 118px;

  overflow: hidden;

  padding: 10px 12px;

  border-radius: 7px;

  border:
    1px solid rgba(126, 111, 218, 0.085);

  background:
    rgba(8, 10, 20, 0.11);

  font-family:
    ui-monospace,
    SFMono-Regular,
    Menlo,
    Monaco,
    Consolas,
    monospace;

  opacity: 0.24;

  transform:
    rotate(0.45deg);
}


.logHeader {
  display: flex;

  align-items: center;

  justify-content:
    space-between;

  margin-bottom: 8px;

  padding-bottom: 6px;

  border-bottom:
    1px solid rgba(122, 111, 202, 0.08);

  color:
    rgba(135, 125, 230, 0.48);

  font-size: 7px;

  letter-spacing: 0.07em;
}


.logPulse {
  width: 4px;
  height: 4px;

  border-radius: 50%;

  background:
    rgba(82, 223, 172, 0.65);

  box-shadow:
    0 0 6px
    rgba(82, 223, 172, 0.55);

  animation:
    statusPulse 1.4s ease-in-out infinite;
}


.logLines {
  font-size: 7px;

  line-height: 1.8;

  white-space: nowrap;

  color:
    rgba(174, 179, 204, 0.42);

  animation:
    logRefresh 2.3s ease-out both;
}


.logTime {
  color:
    rgba(98, 154, 213, 0.45);
}


/* =========================================================
   NETWORK TRACE DECORATION
   ========================================================= */

.networkTrace {
  position: absolute;

  right: 56px;
  bottom: 52px;

  display: flex;

  align-items: flex-end;

  gap: 4px;

  height: 38px;

  opacity: 0.16;
}


.networkTrace span {
  width: 2px;

  border-radius: 4px;

  background:
    linear-gradient(
      to top,
      rgba(83, 190, 231, 0.24),
      rgba(132, 112, 255, 0.56)
    );

  animation:
    networkActivity 1.3s ease-in-out infinite alternate;
}


.networkTrace span:nth-child(1) {
  height: 16px;
}


.networkTrace span:nth-child(2) {
  height: 29px;

  animation-delay: -0.4s;
}


.networkTrace span:nth-child(3) {
  height: 20px;

  animation-delay: -0.8s;
}


.networkTrace span:nth-child(4) {
  height: 35px;

  animation-delay: -0.25s;
}


.networkTrace span:nth-child(5) {
  height: 12px;

  animation-delay: -0.65s;
}


/* =========================================================
   ANIMATIONS
   ========================================================= */

@keyframes terminalFloat {
  0%,
  100% {
    transform:
      rotate(-1.1deg)
      translate3d(0, 0, 0);
  }

  50% {
    transform:
      rotate(-0.75deg)
      translate3d(3px, -4px, 0);
  }
}


@keyframes monitorFloat {
  0%,
  100% {
    transform:
      rotate(1.2deg)
      translateY(0);
  }

  50% {
    transform:
      rotate(0.8deg)
      translateY(-5px);
  }
}


@keyframes terminalRefresh {
  0% {
    opacity: 0;
    transform: translateY(3px);
  }

  9% {
    opacity: 1;
    transform: translateY(0);
  }

  88% {
    opacity: 1;
  }

  100% {
    opacity: 0.2;
  }
}


@keyframes logRefresh {
  0% {
    opacity: 0;
    transform: translateY(7px);
  }

  18% {
    opacity: 1;
    transform: translateY(0);
  }

  85% {
    opacity: 1;
  }

  100% {
    opacity: 0.35;
    transform: translateY(-2px);
  }
}


@keyframes cursorBlink {
  0%,
  48% {
    opacity: 0.8;
  }

  49%,
  100% {
    opacity: 0;
  }
}


@keyframes terminalScan {
  0% {
    top: 15%;
    opacity: 0;
  }

  8% {
    opacity: 0.4;
  }

  50% {
    opacity: 0.16;
  }

  92% {
    opacity: 0.35;
  }

  100% {
    top: 98%;
    opacity: 0;
  }
}


@keyframes statusPulse {
  0%,
  100% {
    opacity: 0.35;
    transform: scale(0.85);
  }

  50% {
    opacity: 1;
    transform: scale(1.18);
  }
}


@keyframes metricActivity {
  from {
    transform:
      scaleX(0.72);
  }

  to {
    transform:
      scaleX(1);
  }
}


@keyframes networkActivity {
  from {
    transform:
      scaleY(0.35);
    opacity: 0.25;
  }

  to {
    transform:
      scaleY(1);
    opacity: 0.75;
  }
}


@keyframes rotateGradient {
  from {
    transform:
      rotate(0deg);
  }

  to {
    transform:
      rotate(360deg);
  }
}


/* =========================================================
   MOBILE
   ========================================================= */

@media (max-width: 767px) {
  .grid {
    grid-template-columns: 1fr;
    gap: 32px;
  }

  .imagePlaceholder {
    width: 200px;
    height: 240px;
    margin: 0 auto;
  }

  .linuxBackdrop {
    top: -35px;
    left: -20px;
    right: -20px;
    bottom: 250px;

    opacity: 0.33;

    mask-image:
      linear-gradient(
        180deg,
        black 0%,
        rgba(0, 0, 0, 0.72) 65%,
        transparent 100%
      );

    -webkit-mask-image:
      linear-gradient(
        180deg,
        black 0%,
        rgba(0, 0, 0, 0.72) 65%,
        transparent 100%
      );
  }

  .terminalWindow {
    width: 96%;
    left: 2%;
  }

  .systemMonitor {
    display: none;
  }

  .logWindow {
    width: 84%;
    left: 8%;
  }
}


/*
 * Respect người dùng tắt animation.
 */
@media (prefers-reduced-motion: reduce) {
  .terminalWindow,
  .systemMonitor,
  .terminalSession,
  .logLines,
  .cursor,
  .scanLine,
  .liveStatus i,
  .logPulse,
  .metricBar span,
  .networkTrace span,
  .imagePlaceholder::after {
    animation: none !important;
  }
}
